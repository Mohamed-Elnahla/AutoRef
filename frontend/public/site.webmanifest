{
  "name": "AutoRef — citations, made live",
  "short_name": "AutoRef",
  "description": "Turn static Word citations into live Zotero fields while preserving document formatting.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f4f6f1",
